  "relationships": [
    {
      "entityA": "BankStatement",
      "entityB": "BankStatementLine",
      "type": "one-to-many",
      "description": "Un estado de cuenta tiene múltiples líneas"
    },
    {
      "entityA": "BankStatement",
      "entityB": "BankAccount",
      "type": "many-to-one",
      "description": "Cada estado pertenece a una cuenta bancaria"
    },
