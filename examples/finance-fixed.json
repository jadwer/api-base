      "description": "Un pago puede aplicarse a múltiples facturas"
    },
    {
      "entityA": "APInvoice",
      "entityB": "APInvoicePayment",
      "type": "one-to-many",
      "description": "Una factura puede tener múltiples pagos aplicados"
    },
    {
      "entityA": "ARReceipt",
