      "type": "one-to-many",
      "description": "Un recibo puede aplicarse a múltiples facturas"
    },
    {
      "entityA": "ARInvoice",
      "entityB": "ARInvoiceReceipt",
      "type": "one-to-many",
      "description": "Una factura puede tener múltiples recibos aplicados"
    },
    {
      "entityA": "APPayment",
      "entityB": "BankAccount",
      "type": "many-to-one",
      "description": "Cada pago AP se realiza desde una cuenta bancaria"
    },
    {
      "entityA": "ARReceipt",
      "entityB": "BankAccount",
      "type": "many-to-one",
      "description": "Cada recibo AR se deposita en una cuenta bancaria"
    }
