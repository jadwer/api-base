#!/bin/sh
# Validacion local antes de empujar (no hay CI: GitHub Actions apagadas por costo).
# Estilo de los commits + Larastan + pruebas de los modulos tocados, en paralelo.
# Las pruebas viven en scripts/verify.sh: correrlo a mano antes del push deja
# una constancia y el hook solo revisa el estilo (push de segundos; si las
# pruebas corren aqui, GitHub puede cerrar la conexion SSH a media prueba).
# Sin constancia valida (otro HEAD, otra base o arbol sucio) corre verify.
# SKIP_VERIFY=1 git push para docs con prisa (solo revisa el estilo).
# Activar una vez por clon: git config core.hooksPath .githooks
set -e
root="$(git rev-parse --show-toplevel)"
cd "$root"
remote="$1"
base="$(sh scripts/push-base.sh "$remote")"

msgs="$(git log --format=%B "$base..HEAD")"
if printf '%s' "$msgs" | grep -q '—'; then echo "pre-push: guion largo en un mensaje de commit"; exit 1; fi
if printf '%s' "$msgs" | grep -qi 'co-authored-by\|generated with claude'; then echo "pre-push: atribucion en un mensaje de commit"; exit 1; fi
if printf '%s' "$msgs" | grep -qP '[\x{1F300}-\x{1FAFF}\x{2600}-\x{27BF}]'; then echo "pre-push: emoji en un mensaje de commit"; exit 1; fi
[ "${SKIP_VERIFY:-}" = 1 ] && exit 0
bash scripts/verify-stamp.sh check "$base" && { echo "pre-push: constancia de verify vigente, sin repetir pruebas"; exit 0; }
exec sh scripts/verify.sh "$remote"
