APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# For development: Use 'log' to save emails to storage/logs/laravel.log
# For testing: Use 'smtp' with Mailtrap (mailtrap.io)
# For production: Use 'smtp' with your email provider (Gmail, SendGrid, etc.)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin notification email for order alerts and return requests
MAIL_ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Example SMTP Configuration for Mailtrap (Testing)
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

# Example SMTP Configuration for Gmail (Production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SW Sapien PAC Configuration (CFDI Stamping)
# Enable PAC integration for CFDI timbrado
SW_PAC_ENABLED=false
# Sandbox: https://services.test.sw.com.mx
# Production: https://services.sw.com.mx
SW_PAC_URL=https://services.test.sw.com.mx
# Option 1: Use pre-generated token (recommended)
SW_PAC_TOKEN=
# Option 2: Use user/password (token auto-generated)
SW_PAC_USER=
SW_PAC_PASSWORD=
# Request timeout in seconds
SW_PAC_TIMEOUT=30
# Retry configuration
SW_PAC_RETRY_ATTEMPTS=3
SW_PAC_RETRY_DELAY=1000
# Webhook signature validation secret
SW_PAC_WEBHOOK_SECRET=

# CFDI Storage Configuration
CFDI_STORAGE_PATH=cfdi
CFDI_XML_PATH=cfdi/xml
CFDI_PDF_PATH=cfdi/pdf

# Stripe Payment Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
# Test keys start with pk_test_ and sk_test_
# Production keys start with pk_live_ and sk_live_
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
