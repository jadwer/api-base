<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="default"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheResult="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory suffix="Test.php">Modules/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory suffix=".php">Modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV"
             value="testing" />
        <env name="APP_MAINTENANCE_DRIVER"
             value="file" />
        <env name="BCRYPT_ROUNDS"
             value="4" />
        <env name="CACHE_STORE"
             value="array" />
        <env name="MAIL_MAILER"
             value="array" />
        <env name="PULSE_ENABLED"
             value="false" />
        <env name="QUEUE_CONNECTION"
             value="sync" />
        <env name="SESSION_DRIVER"
             value="array" />
        <env name="TELESCOPE_ENABLED"
             value="false" />

        <!-- SQLite in-memory for isolated parallel tests -->
        <env name="DB_CONNECTION"
             value="sqlite" />
        <env name="DB_DATABASE"
             value=":memory:" />

        <env name="LOG_LEVEL"
             value="emergency" />
        <!-- Performance optimizations -->
        <env name="CACHE_PREFIX"
             value="test_cache" />
        <env name="APP_DEBUG"
             value="false" />
        <env name="DEBUGBAR_ENABLED"
             value="false" />
        <!-- Disable activity logging in tests -->
        <env name="ACTIVITY_LOGGER_ENABLED"
             value="false" />

        <!-- PAC Integration (SW Sapien) - Enable for integration tests -->
        <env name="SW_PAC_ENABLED"
             value="true" />
        <env name="SW_PAC_URL"
             value="https://services.test.sw.com.mx" />
        <env name="SW_PAC_TIMEOUT"
             value="30" />
        <env name="SW_PAC_RETRY_ATTEMPTS"
             value="3" />

        <!-- Stripe Integration - Keys loaded from .env.testing (not committed) -->
        <!-- Set STRIPE_PUBLISHABLE_KEY and STRIPE_SECRET_KEY in .env.testing -->
    </php>
</phpunit>
