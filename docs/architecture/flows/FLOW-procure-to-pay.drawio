<mxfile host="app.diagrams.net">
  <diagram name="Procure-to-Pay Flow" id="procure-to-pay">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and Legend -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:24px;&quot;&gt;Procure-to-Pay Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete flow from purchase order creation to payment with event-driven automation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;hr&gt;&lt;b style=&quot;color:#673AB7;&quot;&gt;●&lt;/b&gt; Process Step&lt;br&gt;&lt;b style=&quot;color:#F44336;&quot;&gt;●&lt;/b&gt; Decision Point&lt;br&gt;&lt;b style=&quot;color:#4CAF50;&quot;&gt;●&lt;/b&gt; Event Trigger&lt;br&gt;&lt;b style=&quot;color:#FF5722;&quot;&gt;●&lt;/b&gt; Automatic Action&lt;br&gt;&lt;b style=&quot;color:#6A1B9A;&quot;&gt;●&lt;/b&gt; Database Update" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="20" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- Swimlanes -->
        <mxCell id="swimlane-supplier" value="&lt;b&gt;SUPPLIER&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1520" height="120" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-purchasing" value="&lt;b&gt;PURCHASING DEPT&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1520" height="180" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-purchasing-manager" value="&lt;b&gt;PURCHASING MANAGER&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1520" height="140" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-warehouse" value="&lt;b&gt;WAREHOUSE&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1520" height="140" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-system" value="&lt;b&gt;SYSTEM (Events)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1520" height="240" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-finance" value="&lt;b&gt;FINANCE (AP)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="1520" height="160" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-accounting" value="&lt;b&gt;ACCOUNTING (GL)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1520" height="160" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Supplier Swimlane -->
        <mxCell id="supplier-quote" value="Submits quote&lt;br&gt;or catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-supplier">
          <mxGeometry x="60" y="35" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="supplier-deliver" value="Delivers&lt;br&gt;products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-supplier">
          <mxGeometry x="840" y="35" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="supplier-invoice" value="Sends&lt;br&gt;invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-supplier">
          <mxGeometry x="1080" y="35" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Purchasing Dept Swimlane -->
        <mxCell id="purchasing-create-po" value="&lt;b&gt;1. Create Purchase Order&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Select supplier&lt;br&gt;• Add products/quantities&lt;br&gt;• Calculate totals&lt;br&gt;• status='pending'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0288D1;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-purchasing">
          <mxGeometry x="60" y="20" width="140" height="130" as="geometry" />
        </mxCell>

        <mxCell id="purchasing-check-approval" value="&lt;b&gt;Requires&lt;br&gt;Approval?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F44336;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-purchasing">
          <mxGeometry x="260" y="45" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="purchasing-send-order" value="&lt;b&gt;3. Send PO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Email to supplier&lt;br&gt;• status='ordered'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0288D1;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-purchasing">
          <mxGeometry x="640" y="40" width="120" height="100" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Purchasing Manager Swimlane -->
        <mxCell id="manager-review" value="&lt;b&gt;2. Review PO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Check amount&lt;br&gt;• Validate supplier&lt;br&gt;• Budget check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FB8C00;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-purchasing-manager">
          <mxGeometry x="440" y="20" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="manager-approve-decision" value="&lt;b&gt;Approve?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F44336;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-purchasing-manager">
          <mxGeometry x="450" y="-80" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Warehouse Swimlane -->
        <mxCell id="warehouse-receive" value="&lt;b&gt;4. Receive Goods&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Inspect products&lt;br&gt;• Count quantities&lt;br&gt;• Create receipt&lt;br&gt;• status='received'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-warehouse">
          <mxGeometry x="840" y="20" width="140" height="100" as="geometry" />
        </mxCell>

        <!-- Flow Steps in System Swimlane -->
        <mxCell id="system-event-trigger" value="&lt;b&gt;5. Event Trigger&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#4CAF50;&quot;&gt;PurchaseOrderReceived&lt;/b&gt;&lt;br&gt;&lt;br&gt;Payload:&lt;br&gt;• purchaseOrder&lt;br&gt;• orderId&lt;br&gt;• totalAmount&lt;br&gt;• supplierId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;fontStyle=1" vertex="1" parent="swimlane-system">
          <mxGeometry x="840" y="20" width="160" height="190" as="geometry" />
        </mxCell>

        <mxCell id="system-listener" value="&lt;b&gt;6. Event Listener&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PurchaseOrderReceivedListener&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actions:&lt;br&gt;• Check idempotency&lt;br&gt;• Create AP Invoice&lt;br&gt;• Post to GL&lt;br&gt;• Update order&lt;br&gt;• Update inventory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5722;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-system">
          <mxGeometry x="1060" y="20" width="160" height="190" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Finance Swimlane -->
        <mxCell id="finance-ap-invoice" value="&lt;b&gt;7. AP Invoice Created&lt;/b&gt;&lt;br&gt;&lt;br&gt;• invoice_number (auto)&lt;br&gt;• contact_id (supplier)&lt;br&gt;• purchase_order_id (link)&lt;br&gt;• total_amount&lt;br&gt;• status='posted'&lt;br&gt;• gl_posting_status='pending'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EF5350;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-finance">
          <mxGeometry x="1060" y="20" width="160" height="120" as="geometry" />
        </mxCell>

        <mxCell id="finance-make-payment" value="&lt;b&gt;9. Process Payment&lt;/b&gt;&lt;br&gt;&lt;br&gt;• payment_number&lt;br&gt;• payment_date&lt;br&gt;• payment_amount&lt;br&gt;• bank_account_id&lt;br&gt;• status='cleared'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EF5350;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-finance">
          <mxGeometry x="1340" y="20" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Accounting Swimlane -->
        <mxCell id="accounting-gl-posting" value="&lt;b&gt;8. GL Posting (Automatic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Journal Entry:&lt;/b&gt;&lt;br&gt;DR Expense/COGS $Y&lt;br&gt;DR VAT Recoverable $Z&lt;br&gt;   CR Accounts Payable $X&lt;br&gt;&lt;br&gt;• entry_number (auto)&lt;br&gt;• status='posted'&lt;br&gt;• source_type='APInvoice'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-accounting">
          <mxGeometry x="1060" y="20" width="160" height="120" as="geometry" />
        </mxCell>

        <mxCell id="accounting-payment-posting" value="&lt;b&gt;10. Payment GL Posting&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Journal Entry:&lt;/b&gt;&lt;br&gt;DR Accounts Payable $X&lt;br&gt;   CR Bank Account $X&lt;br&gt;&lt;br&gt;• Updates AP balance&lt;br&gt;• paid_amount increased&lt;br&gt;• remaining_balance decreased" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-accounting">
          <mxGeometry x="1340" y="20" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arrow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1" source="supplier-quote" target="purchasing-create-po">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0288D1;" edge="1" parent="1" source="purchasing-create-po" target="purchasing-check-approval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F44336;fontSize=11;fontStyle=1" edge="1" parent="1" source="purchasing-check-approval" target="manager-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-no" value="NO&lt;br&gt;(auto-approve)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="purchasing-check-approval" target="purchasing-send-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FB8C00;" edge="1" parent="1" source="manager-review" target="manager-approve-decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow5-approved" value="APPROVED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="manager-approve-decision" target="purchasing-send-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow5-rejected" value="REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F44336;dashed=1;fontSize=11;fontStyle=1" edge="1" parent="1" source="manager-approve-decision" target="supplier-quote">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="380" />
              <mxPoint x="510" y="200" />
              <mxPoint x="110" y="200" />
              <mxPoint x="110" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0288D1;" edge="1" parent="1" source="purchasing-send-order" target="supplier-deliver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1" source="supplier-deliver" target="warehouse-receive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow8" value="Status→'received'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="warehouse-receive" target="system-event-trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow9" value="Listener&lt;br&gt;invoked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="system-event-trigger" target="system-listener">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow10" value="APInvoiceService&lt;br&gt;.createInvoice()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF5722;fontSize=11;fontStyle=1" edge="1" parent="1" source="system-listener" target="finance-ap-invoice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow11" value="AccountingService&lt;br&gt;.postJournalEntry()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9C27B0;fontSize=11;fontStyle=1" edge="1" parent="1" source="finance-ap-invoice" target="accounting-gl-posting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6A1B9A;dashed=1" edge="1" parent="1" source="accounting-gl-posting" target="supplier-invoice">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1130" y="1080" />
              <mxPoint x="1130" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow13" value="Due date&lt;br&gt;arrives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF5350;fontSize=11;fontStyle=1" edge="1" parent="1" source="finance-ap-invoice" target="finance-make-payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF5350;" edge="1" parent="1" source="finance-make-payment" target="accounting-payment-posting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Annotations -->
        <mxCell id="annotation1" value="&lt;b&gt;Approval Conditions:&lt;/b&gt;&lt;br&gt;• Amount &gt; $5,000&lt;br&gt;• New supplier&lt;br&gt;• Budget exceeded&lt;br&gt;• Non-standard terms" style="text;html=1;strokeColor=#EF6C00;fillColor=#FFF8E1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="240" y="180" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="annotation2" value="&lt;b&gt;Idempotency Check:&lt;/b&gt;&lt;br&gt;Key: purchase_order_received_{id}&lt;br&gt;&lt;br&gt;Prevents duplicate invoice&lt;br&gt;creation if event fires twice" style="text;html=1;strokeColor=#388E3C;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="840" y="1000" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="annotation3" value="&lt;b&gt;Inventory Update:&lt;/b&gt;&lt;br&gt;• Create inventory_movement&lt;br&gt;• movement_type='entry'&lt;br&gt;• Increase stock quantity&lt;br&gt;• Link to purchase_order_id" style="text;html=1;strokeColor=#00695C;fillColor=#E0F2F1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#004D40;" vertex="1" parent="1">
          <mxGeometry x="1000" y="580" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Stats Box -->
        <mxCell id="stats" value="&lt;b&gt;PROCESS STATISTICS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Total Steps:&lt;/b&gt; 10&lt;br&gt;&lt;b&gt;Decision Points:&lt;/b&gt; 2&lt;br&gt;&lt;b&gt;Events:&lt;/b&gt; 1 (PurchaseOrderReceived)&lt;br&gt;&lt;b&gt;Automatic Actions:&lt;/b&gt; 4&lt;br&gt;&lt;b&gt;DB Tables Involved:&lt;/b&gt; 8&lt;br&gt;  • purchase_orders&lt;br&gt;  • purchase_order_items&lt;br&gt;  • ap_invoices&lt;br&gt;  • inventory_movements&lt;br&gt;  • stock&lt;br&gt;  • journal_entries&lt;br&gt;  • journal_lines&lt;br&gt;  • idempotency_keys&lt;br&gt;&lt;br&gt;&lt;b&gt;Avg Time:&lt;/b&gt; 7-14 days&lt;br&gt;&lt;b&gt;Automation Level:&lt;/b&gt; 75%&lt;br&gt;(Invoice + GL + Inventory)" style="text;html=1;strokeColor=#0277BD;fillColor=#E1F5FE;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="280" height="340" as="geometry" />
        </mxCell>

        <!-- Business Rules Box -->
        <mxCell id="business-rules" value="&lt;b&gt;BUSINESS RULES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;1. Approval Tiers (AP):&lt;/b&gt;&lt;br&gt;   • Tier 1: &gt; $100k → CFO&lt;br&gt;   • Tier 2: &gt; $50k → Finance Mgr&lt;br&gt;   • Tier 3: &gt; $5k or new supplier → Purchasing Mgr&lt;br&gt;&lt;br&gt;&lt;b&gt;2. GL Posting:&lt;/b&gt;&lt;br&gt;   • DR Expense/COGS&lt;br&gt;   • DR VAT Recoverable&lt;br&gt;   • CR Accounts Payable&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Status Flow:&lt;/b&gt;&lt;br&gt;   • pending → approved → ordered&lt;br&gt;   • ordered → received&lt;br&gt;   • received triggers event&lt;br&gt;   • event creates invoice + GL + inventory&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Inventory Movement:&lt;/b&gt;&lt;br&gt;   • Type: 'entry'&lt;br&gt;   • Increases stock quantity&lt;br&gt;   • Sets unit_cost&lt;br&gt;   • Links to GL journal_entry_id&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Payment Terms:&lt;/b&gt;&lt;br&gt;   • Net 30/60/90 days&lt;br&gt;   • Early payment discounts&lt;br&gt;   • Payment scheduling" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="1300" width="300" height="480" as="geometry" />
        </mxCell>

        <!-- Integration Points Box -->
        <mxCell id="integration-points" value="&lt;b&gt;INTEGRATION POINTS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Purchase → Finance:&lt;/b&gt;&lt;br&gt;• Event: PurchaseOrderReceived&lt;br&gt;• Listener: PurchaseOrderReceivedListener&lt;br&gt;• Action: Create AP Invoice&lt;br&gt;&lt;br&gt;&lt;b&gt;Finance → Accounting:&lt;/b&gt;&lt;br&gt;• Service call: AccountingService&lt;br&gt;• Action: Create Journal Entry&lt;br&gt;• GL Posting: Automatic&lt;br&gt;&lt;br&gt;&lt;b&gt;Purchase → Inventory:&lt;/b&gt;&lt;br&gt;• Create inventory_movement (entry)&lt;br&gt;• Update stock quantities&lt;br&gt;• Link to GL journal entry&lt;br&gt;&lt;br&gt;&lt;b&gt;Accounting → Finance:&lt;/b&gt;&lt;br&gt;• Update: journal_entry_id&lt;br&gt;• Update: gl_posting_status='posted'&lt;br&gt;&lt;br&gt;&lt;b&gt;Finance → Purchase:&lt;/b&gt;&lt;br&gt;• Update: ap_invoice_id&lt;br&gt;• Update: invoicing_status&lt;br&gt;• Update: financial_status&lt;br&gt;&lt;br&gt;&lt;b&gt;Safety Features:&lt;/b&gt;&lt;br&gt;• Idempotency check&lt;br&gt;• DB transactions&lt;br&gt;• Exception handling&lt;br&gt;• Comprehensive logging&lt;br&gt;• Inventory rollback on failure" style="text;html=1;strokeColor=#388E3C;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1300" width="340" height="520" as="geometry" />
        </mxCell>

        <!-- Three-Way Match Box -->
        <mxCell id="three-way-match" value="&lt;b&gt;THREE-WAY MATCH&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Optional Enhanced Control:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Purchase Order&lt;/b&gt;&lt;br&gt;   • Ordered quantity&lt;br&gt;   • Unit price&lt;br&gt;   • Total amount&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Receipt Document&lt;/b&gt;&lt;br&gt;   • Received quantity&lt;br&gt;   • Quality inspection&lt;br&gt;   • Warehouse receipt#&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Supplier Invoice&lt;/b&gt;&lt;br&gt;   • Invoiced quantity&lt;br&gt;   • Invoice amount&lt;br&gt;   • Payment terms&lt;br&gt;&lt;br&gt;&lt;b&gt;Validation Rules:&lt;/b&gt;&lt;br&gt;• Quantities must match&lt;br&gt;• Prices within tolerance (±5%)&lt;br&gt;• Discrepancies flagged&lt;br&gt;• Approval required for variances&lt;br&gt;&lt;br&gt;&lt;b&gt;Benefit:&lt;/b&gt;&lt;br&gt;Prevents overpayment and fraud" style="text;html=1;strokeColor=#0277BD;fillColor=#E1F5FE;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1300" width="300" height="520" as="geometry" />
        </mxCell>

        <!-- Performance Notes Box -->
        <mxCell id="performance-notes" value="&lt;b&gt;PERFORMANCE NOTES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Event Processing:&lt;/b&gt;&lt;br&gt;• Async queue (non-blocking)&lt;br&gt;• Process time: ~3-8 seconds&lt;br&gt;• Retry on failure (3 attempts)&lt;br&gt;&lt;br&gt;&lt;b&gt;Database Queries:&lt;/b&gt;&lt;br&gt;• Indexed foreign keys&lt;br&gt;• Composite indexes on status+contact&lt;br&gt;• Generated columns for balances&lt;br&gt;• Query time: &lt;100ms avg&lt;br&gt;&lt;br&gt;&lt;b&gt;Inventory Impact:&lt;/b&gt;&lt;br&gt;• Stock update: immediate&lt;br&gt;• Movement log: auditable&lt;br&gt;• FEFO strategy for batches&lt;br&gt;&lt;br&gt;&lt;b&gt;Bottlenecks to Monitor:&lt;/b&gt;&lt;br&gt;• Large item counts (100+ items)&lt;br&gt;• GL posting (many journal lines)&lt;br&gt;• Stock updates (locking)&lt;br&gt;&lt;br&gt;&lt;b&gt;Scalability:&lt;/b&gt;&lt;br&gt;• Handles 500+ POs/day&lt;br&gt;• Queue workers: 3-5 recommended&lt;br&gt;• Database: 50k+ POs supported" style="text;html=1;strokeColor=#EF6C00;fillColor=#FFF8E1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1300" width="280" height="520" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
