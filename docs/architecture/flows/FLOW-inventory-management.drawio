        <mxCell id="transfer-increase-dest" value="&lt;b&gt;Destination +&lt;/b&gt;&lt;br&gt;&lt;br&gt;dest_stock.&lt;br&gt;quantity&lt;br&gt;+= quantity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="1">
