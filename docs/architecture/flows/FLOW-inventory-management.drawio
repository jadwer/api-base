          <mxGeometry x="600" y="1200" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row2-auth" value="Warehouse Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
