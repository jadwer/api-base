        <mxCell id="row2-audit" value="previous_stock,&lt;br&gt;new_stock,&lt;br&gt;SO reference,&lt;br&gt;batch_id (FEFO)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
