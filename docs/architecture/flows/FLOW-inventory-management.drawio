        <mxCell id="row4-type" value="&lt;b&gt;ADJUSTMENT&lt;/b&gt;&lt;br&gt;(Manual)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1320" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row4-trigger" value="Cycle count,&lt;br&gt;Physical inventory,&lt;br&gt;Damage/theft" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="1320" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row4-stock" value="Set to actual count&lt;br&gt;(± as needed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="1320" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row4-gl" value="Shortage: DR Inv Adjust Expense, CR Inv&lt;br&gt;Overage: DR Inv, CR Inv Adjust Expense" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="1320" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row4-auth" value="Finance Manager&lt;br&gt;(requires approval)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="880" y="1320" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row4-audit" value="previous_stock,&lt;br&gt;new_stock,&lt;br&gt;reason (required),&lt;br&gt;approved_by" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1320" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="row4-examples" value="Physical inventory variance,&lt;br&gt;Damaged goods write-off,&lt;br&gt;Theft loss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1320" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Business Rules Box -->
        <mxCell id="business-rules" value="&lt;b style=&quot;font-size:14px;&quot;&gt;BUSINESS RULES &amp; VALIDATIONS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;1. Stock Availability Check:&lt;/b&gt;&lt;br&gt;   • available_quantity = quantity - reserved_quantity&lt;br&gt;   • Exit/Transfer must check available_quantity &gt;= requested&lt;br&gt;   • Negative stock not allowed (except with override permission)&lt;br&gt;&lt;br&gt;&lt;b&gt;2. FEFO Strategy (First Expired, First Out):&lt;/b&gt;&lt;br&gt;   • For exits, select batch with earliest expiration_date&lt;br&gt;   • Quality check: quality_status = 'passed' required&lt;br&gt;   • Expired batches (expiration_date &lt; today) blocked&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Audit Trail Requirements:&lt;/b&gt;&lt;br&gt;   • previous_stock (before movement)&lt;br&gt;   • new_stock (after movement)&lt;br&gt;   • performed_by (user_id) required&lt;br&gt;   • reason required for adjustments&lt;br&gt;   • reference_type + reference_id for linked movements&lt;br&gt;&lt;br&gt;&lt;b&gt;4. GL Posting Rules:&lt;/b&gt;&lt;br&gt;   • Entry: DR Inventory Asset, CR AP&lt;br&gt;   • Exit: DR COGS, CR Inventory Asset&lt;br&gt;   • Transfer: DR Inv Dest WH, CR Inv Source WH (if different accounts)&lt;br&gt;   • Adjustment: DR/CR Inventory Adjustment Expense&lt;br&gt;   • All postings link via gl_journal_entry_id&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Authorization Matrix:&lt;/b&gt;&lt;br&gt;   • Entry/Exit: Warehouse Manager&lt;br&gt;   • Transfer: Operations Manager + approval if &gt; threshold&lt;br&gt;   • Adjustment: Finance Manager approval required&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Transaction Safety:&lt;/b&gt;&lt;br&gt;   • DB transactions for atomic operations&lt;br&gt;   • Row-level locking on stock updates (prevent race conditions)&lt;br&gt;   • Transfer: both warehouses updated atomically or rollback&lt;br&gt;   • GL posting failure = rollback inventory movement" style="text;html=1;strokeColor=#1976D2;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="580" height="600" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
