        <mxCell id="entry-trigger" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;&lt;br&gt;Purchase Order&lt;br&gt;status='received'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1" vertex="1" parent="1">
