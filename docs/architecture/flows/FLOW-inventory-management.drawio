        <mxCell id="row3-stock" value="Source: -quantity&lt;br&gt;Destination: +quantity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
