        <mxCell id="row3-type" value="&lt;b&gt;TRANSFER&lt;/b&gt;&lt;br&gt;(Between WH)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#2196F3;fontSize=11;align=left;" vertex="1" parent="1">
