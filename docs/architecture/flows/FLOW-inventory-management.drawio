        <mxCell id="row3-audit" value="previous_stock (both),&lt;br&gt;new_stock (both),&lt;br&gt;destination_warehouse_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=10;align=left;" vertex="1" parent="1">
