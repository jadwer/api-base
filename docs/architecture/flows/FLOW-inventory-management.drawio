        <mxCell id="entry-validate" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Check PO exists&lt;br&gt;• Verify quantities&lt;br&gt;• Inspect quality" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="1">
