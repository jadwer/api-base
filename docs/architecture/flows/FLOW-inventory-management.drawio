<mxfile host="app.diagrams.net">
  <diagram name="Inventory Management Flow" id="inventory-management">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:24px;&quot;&gt;Inventory Management - Movement Types Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete workflow for 4 movement types: Entry, Exit, Transfer, Adjustment" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="80" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;MOVEMENT TYPES&lt;/b&gt;&lt;hr&gt;&lt;b style=&quot;color:#2E7D32;&quot;&gt;●&lt;/b&gt; Entry (Receiving)&lt;br&gt;&lt;b style=&quot;color:#D32F2F;&quot;&gt;●&lt;/b&gt; Exit (Shipping)&lt;br&gt;&lt;b style=&quot;color:#1976D2;&quot;&gt;●&lt;/b&gt; Transfer (Between WH)&lt;br&gt;&lt;b style=&quot;color:#F57C00;&quot;&gt;●&lt;/b&gt; Adjustment (Manual)&lt;br&gt;&lt;br&gt;&lt;b&gt;AUDIT TRAIL&lt;/b&gt;&lt;hr&gt;All movements log:&lt;br&gt;• previous_stock&lt;br&gt;• new_stock&lt;br&gt;• performed_by&lt;br&gt;• reason" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="240" height="280" as="geometry" />
        </mxCell>

        <!-- ====== ENTRY FLOW (Receiving) ====== -->
        <mxCell id="section-entry" value="&lt;b style=&quot;font-size:16px;&quot;&gt;1. ENTRY (Receiving)&lt;/b&gt;" style="text;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
