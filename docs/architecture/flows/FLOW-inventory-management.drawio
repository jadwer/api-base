        <!-- ====== ADJUSTMENT FLOW ====== -->
        <mxCell id="section-adjustment" value="&lt;b style=&quot;font-size:16px;&quot;&gt;4. ADJUSTMENT (Manual Correction)&lt;/b&gt;" style="text;html=1;strokeColor=#E65100;fillColor=#FFF3E0;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#BF360C;" vertex="1" parent="1">
