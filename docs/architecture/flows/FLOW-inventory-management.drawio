          <mxGeometry x="380" y="180" width="120" height="100" as="geometry" />
        </mxCell>

        <mxCell id="entry-update-stock" value="&lt;b&gt;Update Stock&lt;/b&gt;&lt;br&gt;&lt;br&gt;stock.quantity&lt;br&gt;+= quantity&lt;br&gt;&lt;br&gt;previous_stock&lt;br&gt;→ new_stock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="1">
