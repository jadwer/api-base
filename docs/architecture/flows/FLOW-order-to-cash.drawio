<mxfile host="app.diagrams.net">
  <diagram name="Order-to-Cash Flow" id="order-to-cash">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and Legend -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:24px;&quot;&gt;Order-to-Cash Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete flow from sales order creation to payment receipt with event-driven automation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;hr&gt;&lt;b style=&quot;color:#1168BD;&quot;&gt;●&lt;/b&gt; Process Step&lt;br&gt;&lt;b style=&quot;color:#C62828;&quot;&gt;●&lt;/b&gt; Decision Point&lt;br&gt;&lt;b style=&quot;color:#2E7D32;&quot;&gt;●&lt;/b&gt; Event Trigger&lt;br&gt;&lt;b style=&quot;color:#F57C00;&quot;&gt;●&lt;/b&gt; Automatic Action&lt;br&gt;&lt;b style=&quot;color:#6A1B9A;&quot;&gt;●&lt;/b&gt; Database Update" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="20" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- Swimlanes -->
        <mxCell id="swimlane-customer" value="&lt;b&gt;CUSTOMER&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1520" height="140" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-sales-rep" value="&lt;b&gt;SALES REP&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="1520" height="180" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-sales-manager" value="&lt;b&gt;SALES MANAGER&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1520" height="140" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-system" value="&lt;b&gt;SYSTEM (Events)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1520" height="240" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-finance" value="&lt;b&gt;FINANCE&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor="#FFEBEE;strokeColor=#C62828;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1520" height="180" as="geometry" />
        </mxCell>

        <mxCell id="swimlane-accounting" value="&lt;b&gt;ACCOUNTING (GL)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1520" height="180" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Customer Swimlane -->
        <mxCell id="customer-start" value="Customer submits&lt;br&gt;order request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-customer">
          <mxGeometry x="60" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="customer-receive-invoice" value="Receives&lt;br&gt;AR Invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-customer">
          <mxGeometry x="1120" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="customer-payment" value="Makes&lt;br&gt;payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-customer">
          <mxGeometry x="1340" y="40" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Sales Rep Swimlane -->
        <mxCell id="sales-create-order" value="&lt;b&gt;1. Create Sales Order&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Select customer&lt;br&gt;• Add products/quantities&lt;br&gt;• Calculate totals&lt;br&gt;• status='pending'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2196F3;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-sales-rep">
          <mxGeometry x="60" y="20" width="140" height="130" as="geometry" />
        </mxCell>

        <mxCell id="sales-check-approval" value="&lt;b&gt;Requires&lt;br&gt;Approval?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F44336;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-sales-rep">
          <mxGeometry x="260" y="45" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="sales-process-order" value="&lt;b&gt;3. Process Order&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Reserve inventory&lt;br&gt;• Prepare shipment&lt;br&gt;• Update status to&lt;br&gt;  'completed'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2196F3;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-sales-rep">
          <mxGeometry x="640" y="20" width="140" height="130" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Sales Manager Swimlane -->
        <mxCell id="manager-review" value="&lt;b&gt;2. Review Order&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Check amount&lt;br&gt;• Validate customer&lt;br&gt;• Credit check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E91E63;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-sales-manager">
          <mxGeometry x="440" y="20" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="manager-approve-decision" value="&lt;b&gt;Approve?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F44336;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1" vertex="1" parent="swimlane-sales-manager">
          <mxGeometry x="450" y="-80" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Flow Steps in System Swimlane -->
        <mxCell id="system-event-trigger" value="&lt;b&gt;4. Event Trigger&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#4CAF50;&quot;&gt;SalesOrderCompleted&lt;/b&gt;&lt;br&gt;&lt;br&gt;Payload:&lt;br&gt;• salesOrder&lt;br&gt;• orderId&lt;br&gt;• totalAmount&lt;br&gt;• customerId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;fontStyle=1" vertex="1" parent="swimlane-system">
          <mxGeometry x="840" y="20" width="160" height="190" as="geometry" />
        </mxCell>

        <mxCell id="system-listener" value="&lt;b&gt;5. Event Listener&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SalesOrderCompletedListener&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actions:&lt;br&gt;• Check idempotency&lt;br&gt;• Validate credit&lt;br&gt;• Create AR Invoice&lt;br&gt;• Post to GL&lt;br&gt;• Update order" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-system">
          <mxGeometry x="1060" y="20" width="160" height="190" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Finance Swimlane -->
        <mxCell id="finance-ar-invoice" value="&lt;b&gt;6. AR Invoice Created&lt;/b&gt;&lt;br&gt;&lt;br&gt;• invoice_number (auto)&lt;br&gt;• contact_id (customer)&lt;br&gt;• sales_order_id (link)&lt;br&gt;• total_amount&lt;br&gt;• status='posted'&lt;br&gt;• gl_posting_status='pending'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EF5350;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-finance">
          <mxGeometry x="1060" y="20" width="160" height="140" as="geometry" />
        </mxCell>

        <mxCell id="finance-receive-payment" value="&lt;b&gt;8. Record Payment&lt;/b&gt;&lt;br&gt;&lt;br&gt;• payment_number&lt;br&gt;• payment_date&lt;br&gt;• payment_amount&lt;br&gt;• bank_account_id&lt;br&gt;• status='cleared'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EF5350;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-finance">
          <mxGeometry x="1340" y="20" width="140" height="140" as="geometry" />
        </mxCell>

        <!-- Flow Steps in Accounting Swimlane -->
        <mxCell id="accounting-gl-posting" value="&lt;b&gt;7. GL Posting (Automatic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Journal Entry:&lt;/b&gt;&lt;br&gt;DR Accounts Receivable $X&lt;br&gt;   CR Revenue $Y&lt;br&gt;   CR VAT Payable $Z&lt;br&gt;&lt;br&gt;• entry_number (auto)&lt;br&gt;• status='posted'&lt;br&gt;• source_type='ARInvoice'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-accounting">
          <mxGeometry x="1060" y="20" width="160" height="140" as="geometry" />
        </mxCell>

        <mxCell id="accounting-payment-posting" value="&lt;b&gt;9. Payment GL Posting&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Journal Entry:&lt;/b&gt;&lt;br&gt;DR Bank Account $X&lt;br&gt;   CR Accounts Receivable $X&lt;br&gt;&lt;br&gt;• Updates AR balance&lt;br&gt;• paid_amount increased&lt;br&gt;• remaining_balance decreased" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=none;fontColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="swimlane-accounting">
          <mxGeometry x="1340" y="20" width="140" height="140" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arrow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976D2;" edge="1" parent="1" source="customer-start" target="sales-create-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2196F3;" edge="1" parent="1" source="sales-create-order" target="sales-check-approval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F44336;fontSize=11;fontStyle=1" edge="1" parent="1" source="sales-check-approval" target="manager-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-no" value="NO&lt;br&gt;(auto-approve)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="sales-check-approval" target="sales-process-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E91E63;" edge="1" parent="1" source="manager-review" target="manager-approve-decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow5-approved" value="APPROVED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="manager-approve-decision" target="sales-process-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow5-rejected" value="REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F44336;dashed=1;fontSize=11;fontStyle=1" edge="1" parent="1" source="manager-approve-decision" target="customer-start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="400" />
              <mxPoint x="510" y="220" />
              <mxPoint x="110" y="220" />
              <mxPoint x="110" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow6" value="Status→'completed'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="sales-process-order" target="system-event-trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow7" value="Listener&lt;br&gt;invoked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4CAF50;fontSize=11;fontStyle=1" edge="1" parent="1" source="system-event-trigger" target="system-listener">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow8" value="ARInvoiceService&lt;br&gt;.createInvoice()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF9800;fontSize=11;fontStyle=1" edge="1" parent="1" source="system-listener" target="finance-ar-invoice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow9" value="AccountingService&lt;br&gt;.postJournalEntry()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9C27B0;fontSize=11;fontStyle=1" edge="1" parent="1" source="finance-ar-invoice" target="accounting-gl-posting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF5350;" edge="1" parent="1" source="finance-ar-invoice" target="customer-receive-invoice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976D2;" edge="1" parent="1" source="customer-receive-invoice" target="customer-payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976D2;" edge="1" parent="1" source="customer-payment" target="finance-receive-payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF5350;" edge="1" parent="1" source="finance-receive-payment" target="accounting-payment-posting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Annotations -->
        <mxCell id="annotation1" value="&lt;b&gt;Approval Conditions:&lt;/b&gt;&lt;br&gt;• Amount &gt; $10,000&lt;br&gt;• First-time customer&lt;br&gt;• Credit limit exceeded&lt;br&gt;• Payment score &lt; 60%" style="text;html=1;strokeColor=#F57C00;fillColor=#FFF8E1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="240" y="200" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="annotation2" value="&lt;b&gt;Idempotency Check:&lt;/b&gt;&lt;br&gt;Key: sales_order_completed_{id}&lt;br&gt;&lt;br&gt;Prevents duplicate invoice&lt;br&gt;creation if event fires twice" style="text;html=1;strokeColor=#388E3C;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="840" y="880" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="annotation3" value="&lt;b&gt;Database Updates:&lt;/b&gt;&lt;br&gt;sales_order:&lt;br&gt;• ar_invoice_id = X&lt;br&gt;• invoicing_status = 'fully_invoiced'&lt;br&gt;• financial_status = 'posted'" style="text;html=1;strokeColor=#6A1B9A;fillColor=#F3E5F5;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="1240" y="880" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Stats Box -->
        <mxCell id="stats" value="&lt;b&gt;PROCESS STATISTICS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Total Steps:&lt;/b&gt; 9&lt;br&gt;&lt;b&gt;Decision Points:&lt;/b&gt; 2&lt;br&gt;&lt;b&gt;Events:&lt;/b&gt; 1 (SalesOrderCompleted)&lt;br&gt;&lt;b&gt;Automatic Actions:&lt;/b&gt; 3&lt;br&gt;&lt;b&gt;DB Tables Involved:&lt;/b&gt; 6&lt;br&gt;  • sales_orders&lt;br&gt;  • sales_order_items&lt;br&gt;  • ar_invoices&lt;br&gt;  • journal_entries&lt;br&gt;  • journal_lines&lt;br&gt;  • idempotency_keys&lt;br&gt;&lt;br&gt;&lt;b&gt;Avg Time:&lt;/b&gt; 2-5 days&lt;br&gt;&lt;b&gt;Automation Level:&lt;/b&gt; 70%&lt;br&gt;(Invoice + GL automatic)" style="text;html=1;strokeColor=#1976D2;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="280" height="340" as="geometry" />
        </mxCell>

        <!-- Business Rules Box -->
        <mxCell id="business-rules" value="&lt;b&gt;BUSINESS RULES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;1. Credit Validation:&lt;/b&gt;&lt;br&gt;   • Credit limit check&lt;br&gt;   • Overdue amount check&lt;br&gt;   • Payment score ≥ 60%&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Approval Tiers:&lt;/b&gt;&lt;br&gt;   • Tier 1: &gt; $100k → CFO&lt;br&gt;   • Tier 2: &gt; $50k → Finance Mgr&lt;br&gt;   • Tier 3: &gt; $10k or first-time → Sales Mgr&lt;br&gt;&lt;br&gt;&lt;b&gt;3. GL Posting:&lt;/b&gt;&lt;br&gt;   • DR Customers (AR)&lt;br&gt;   • CR Revenue&lt;br&gt;   • CR VAT Payable&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Status Flow:&lt;/b&gt;&lt;br&gt;   • pending → approved → completed&lt;br&gt;   • completed triggers event&lt;br&gt;   • event creates invoice&lt;br&gt;   • invoice posts to GL&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Payment Application:&lt;/b&gt;&lt;br&gt;   • Can apply to multiple invoices&lt;br&gt;   • Updates paid_amount&lt;br&gt;   • Updates remaining_balance&lt;br&gt;   • Status changes to 'paid' when&lt;br&gt;     remaining_balance = 0" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="1220" width="300" height="460" as="geometry" />
        </mxCell>

        <!-- Integration Points Box -->
        <mxCell id="integration-points" value="&lt;b&gt;INTEGRATION POINTS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Sales → Finance:&lt;/b&gt;&lt;br&gt;• Event: SalesOrderCompleted&lt;br&gt;• Listener: SalesOrderCompletedListener&lt;br&gt;• Action: Create AR Invoice&lt;br&gt;&lt;br&gt;&lt;b&gt;Finance → Accounting:&lt;/b&gt;&lt;br&gt;• Service call: AccountingService&lt;br&gt;• Action: Create Journal Entry&lt;br&gt;• GL Posting: Automatic&lt;br&gt;&lt;br&gt;&lt;b&gt;Accounting → Finance:&lt;/b&gt;&lt;br&gt;• Update: journal_entry_id&lt;br&gt;• Update: gl_posting_status='posted'&lt;br&gt;&lt;br&gt;&lt;b&gt;Finance → Sales:&lt;/b&gt;&lt;br&gt;• Update: ar_invoice_id&lt;br&gt;• Update: invoicing_status&lt;br&gt;• Update: financial_status&lt;br&gt;&lt;br&gt;&lt;b&gt;Safety Features:&lt;/b&gt;&lt;br&gt;• Idempotency check (prevent duplicates)&lt;br&gt;• DB transactions (atomic operations)&lt;br&gt;• Exception handling (non-blocking)&lt;br&gt;• Comprehensive logging" style="text;html=1;strokeColor=#388E3C;fillColor=#E8F5E9;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1220" width="340" height="460" as="geometry" />
        </mxCell>

        <!-- Service Methods Box -->
        <mxCell id="service-methods" value="&lt;b&gt;SERVICE METHODS USED&lt;/b&gt;&lt;hr&gt;&lt;b&gt;CreditManagementService:&lt;/b&gt;&lt;br&gt;• validateCustomerCredit()&lt;br&gt;• getCurrentARBalance()&lt;br&gt;• getOverdueAmount()&lt;br&gt;• calculatePaymentScore()&lt;br&gt;&lt;br&gt;&lt;b&gt;ApprovalWorkflowService:&lt;/b&gt;&lt;br&gt;• requiresARApproval()&lt;br&gt;• getRequiredApprovers()&lt;br&gt;• approveInvoice()&lt;br&gt;&lt;br&gt;&lt;b&gt;ARInvoiceService:&lt;/b&gt;&lt;br&gt;• createInvoice()&lt;br&gt;• updateInvoice()&lt;br&gt;• calculateRemainingBalance()&lt;br&gt;• isFullyPaid()&lt;br&gt;&lt;br&gt;&lt;b&gt;AccountingService:&lt;/b&gt;&lt;br&gt;• createJournalEntry()&lt;br&gt;• postJournalEntry()&lt;br&gt;• validateBalance()&lt;br&gt;&lt;br&gt;&lt;b&gt;PaymentApplicationService:&lt;/b&gt;&lt;br&gt;• applyPayment()&lt;br&gt;• unapplyPayment()&lt;br&gt;• getApplicationHistory()&lt;br&gt;&lt;br&gt;&lt;b&gt;AuditTrailService:&lt;/b&gt;&lt;br&gt;• logCriticalAction()&lt;br&gt;• verifyAuditIntegrity()" style="text;html=1;strokeColor=#6A1B9A;fillColor=#F3E5F5;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1220" width="300" height="460" as="geometry" />
        </mxCell>

        <!-- Performance Notes Box -->
        <mxCell id="performance-notes" value="&lt;b&gt;PERFORMANCE NOTES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Event Processing:&lt;/b&gt;&lt;br&gt;• Async queue (non-blocking)&lt;br&gt;• Process time: ~2-5 seconds&lt;br&gt;• Retry on failure (3 attempts)&lt;br&gt;&lt;br&gt;&lt;b&gt;Database Queries:&lt;/b&gt;&lt;br&gt;• Indexed foreign keys&lt;br&gt;• Composite indexes on status+contact&lt;br&gt;• Generated columns for balances&lt;br&gt;• Query time: &lt;100ms avg&lt;br&gt;&lt;br&gt;&lt;b&gt;Bottlenecks to Monitor:&lt;/b&gt;&lt;br&gt;• Credit validation (external calls)&lt;br&gt;• GL posting (many journal lines)&lt;br&gt;• Payment application (multiple invoices)&lt;br&gt;&lt;br&gt;&lt;b&gt;Scalability:&lt;/b&gt;&lt;br&gt;• Handles 1000+ orders/day&lt;br&gt;• Queue workers: 3-5 recommended&lt;br&gt;• Database: 100k+ orders supported" style="text;html=1;strokeColor=#F57C00;fillColor=#FFF8E1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1220" width="280" height="460" as="geometry" />
        </mxCell>

