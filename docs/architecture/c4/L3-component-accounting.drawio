        <!-- Notes -->
        <mxCell id="notes" value="&lt;b&gt;Key Features:&lt;/b&gt;&lt;br&gt;• Hierarchical Chart of Accounts (90+ accounts, 4 levels)&lt;br&gt;• Period Controls (open/locked/closed) with validation - Phase 3&lt;br&gt;• Automatic balance calculation via database triggers&lt;br&gt;• SAT compliance with 7-15 year retention - Phase 3&lt;br&gt;• Concurrent sequence generation with fiscal year support&lt;br&gt;• Idempotency checks prevent duplicate postings&lt;br&gt;• Balance validation: debit = credit within $0.01&lt;br&gt;• MySQL/PostgreSQL support, SQLite for testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E8B44A;align=left;verticalAlign=top;fontSize=9;fontColor=#333333;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
