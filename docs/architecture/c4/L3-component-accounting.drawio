        <!-- Database Constraints -->
        <mxCell id="constraints-label" value="Database Integrity Layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="250" height="30" as="geometry" />
        </mxCell>

        <mxCell id="check-constraints" value="&lt;b&gt;CHECK Constraints (5)&lt;/b&gt;&lt;br&gt;[Database Layer]&lt;br&gt;&lt;br&gt;• FiscalPeriod.status IN (open, locked, closed)&lt;br&gt;• JournalEntry.status IN (draft, approved, posted, reversed)&lt;br&gt;• Account.account_type IN (asset, liability, equity, revenue, expense)&lt;br&gt;• Account.nature IN (debit, credit)&lt;br&gt;• JournalLine.debit XOR credit (only one can be non-zero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;fontColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="750" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="triggers" value="&lt;b&gt;MySQL Triggers (4)&lt;/b&gt;&lt;br&gt;[Database Layer]&lt;br&gt;&lt;br&gt;• journal_lines_after_insert → Update total_debit/credit&lt;br&gt;• journal_lines_after_update → Update total_debit/credit&lt;br&gt;• journal_lines_after_delete → Update total_debit/credit&lt;br&gt;• Auto-balance calculation on journal_entries table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;fontColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="750" width="360" height="100" as="geometry" />
