        <!-- AccountingService -->
        <mxCell id="accounting-service" value="&lt;b&gt;AccountingService&lt;/b&gt;&lt;br&gt;[Service Component]&lt;br&gt;&lt;br&gt;• createJournalEntry()&lt;br&gt;• postJournalEntry()&lt;br&gt;• reverseJournalEntry()&lt;br&gt;• approveJournalEntry()&lt;br&gt;• validateBalance()&lt;br&gt;• validatePeriod()&lt;br&gt;• validateAccounts()&lt;br&gt;&lt;br&gt;Core GL operations with validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5E1A5;strokeColor=#33691E;strokeWidth=2;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- PeriodControlService -->
        <mxCell id="period-service" value="&lt;b&gt;PeriodControlService&lt;/b&gt;&lt;br&gt;[Service Component - Phase 3]&lt;br&gt;&lt;br&gt;• validatePeriodAccess()&lt;br&gt;• lockPeriod()&lt;br&gt;• unlockPeriod()&lt;br&gt;• closePeriod()&lt;br&gt;• reopenPeriod()&lt;br&gt;• getPeriodStatistics()&lt;br&gt;&lt;br&gt;Period lifecycle management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5E1A5;strokeColor=#33691E;strokeWidth=2;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="200" width="240" height="170" as="geometry" />
        </mxCell>

        <!-- AuditTrailService -->
        <mxCell id="audit-service" value="&lt;b&gt;AuditTrailService&lt;/b&gt;&lt;br&gt;[Service Component - Phase 3]&lt;br&gt;&lt;br&gt;• logFinancialTransaction()&lt;br&gt;• logCriticalAction()&lt;br&gt;• verifyAuditIntegrity()&lt;br&gt;• getAuditTrail()&lt;br&gt;• getCriticalActionsLog()&lt;br&gt;• getComplianceReport()&lt;br&gt;• purgeOldAuditLogs()&lt;br&gt;&lt;br&gt;SAT compliance (7-15 yr retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5E1A5;strokeColor=#33691E;strokeWidth=2;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="200" width="240" height="170" as="geometry" />
        </mxCell>

        <!-- SequenceService -->
        <mxCell id="sequence-service" value="&lt;b&gt;SequenceService&lt;/b&gt;&lt;br&gt;[Service Component]&lt;br&gt;&lt;br&gt;• getNextSequence()&lt;br&gt;• lockForUpdate()&lt;br&gt;• generateNumber()&lt;br&gt;&lt;br&gt;Concurrent sequence generation&lt;br&gt;with fiscal year support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5E1A5;strokeColor=#33691E;strokeWidth=2;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
