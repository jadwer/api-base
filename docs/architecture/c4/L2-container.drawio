        <!-- Notes -->
        <mxCell id="notes" value="&lt;b&gt;Key Integration Patterns:&lt;/b&gt;&lt;br&gt;• Event-Driven: Sales/Purchase → Finance (auto-invoice creation)&lt;br&gt;• Direct Service Calls: Finance → Accounting (GL posting)&lt;br&gt;• Party Pattern: All modules use Contact for customers/suppliers&lt;br&gt;• Shared Services: PermissionManager, Activity Log&lt;br&gt;• Database-level: Foreign key constraints enforce relationships" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E8B44A;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
