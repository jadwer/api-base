        <!-- Central System -->
        <mxCell id="erp-system" value="&lt;b&gt;Laravel Modular ERP&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Complete enterprise resource planning system with integrated modules for Product Management, Inventory, Sales, Purchasing, E-commerce, Finance, and Accounting. Provides JSON:API endpoints, event-driven integration, and real-time financial reporting.&lt;br&gt;&lt;br&gt;• 7 core business modules&lt;br&gt;• 32+ entities with full CRUD&lt;br&gt;• Order-to-Cash automation&lt;br&gt;• Procure-to-Pay automation&lt;br&gt;• Credit management &amp;amp; approval workflows&lt;br&gt;• SAT compliance (7-15 year retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="490" height="340" as="geometry" />
        </mxCell>

        <!-- External Systems - Right Side -->

        <!-- Payment Gateway -->
        <mxCell id="payment-gateway" value="&lt;b&gt;Payment Gateway&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Stripe, MercadoPago&lt;br&gt;&lt;br&gt;Processes online payments from customers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;fontColor=#ffffff;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="950" y="180" width="180" height="120" as="geometry" />
