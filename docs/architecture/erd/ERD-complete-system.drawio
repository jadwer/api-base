        <mxCell id="rel-line-account" value="" style="endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;fontSize=10;strokeWidth=2;strokeColor=#1B5E20;" edge="1" parent="1" source="journal_lines" target="accounts">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2310" y="360" />
              <mxPoint x="2040" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt;&lt;br&gt;🔑 Primary Key&lt;br&gt;🔗 Foreign Key&lt;br&gt;&lt;br&gt;&lt;b&gt;Module Colors:&lt;/b&gt;&lt;br&gt;🔵 Product (Blue)&lt;br&gt;🟢 Inventory (Green)&lt;br&gt;🟠 Contacts (Orange)&lt;br&gt;🔵 Sales (Light Blue)&lt;br&gt;🟣 Purchase (Purple)&lt;br&gt;🔴 Finance (Red)&lt;br&gt;🟢 Accounting (Dark Green)&lt;br&gt;&lt;br&gt;&lt;b&gt;Relationships:&lt;/b&gt;&lt;br&gt;─── One to Many&lt;br&gt;Crow's Foot Notation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;spacingLeft=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="1080" width="300" height="320" as="geometry" />
        </mxCell>

        <!-- Summary Stats -->
        <mxCell id="stats" value="&lt;b style='font-size:14px;'&gt;System Statistics&lt;/b&gt;&lt;hr&gt;&lt;br&gt;&lt;b&gt;Total Tables:&lt;/b&gt; 39+&lt;br&gt;&lt;b&gt;Total Modules:&lt;/b&gt; 7 core + 2 supporting&lt;br&gt;&lt;b&gt;Foreign Key Relationships:&lt;/b&gt; 40+&lt;br&gt;&lt;br&gt;&lt;b&gt;By Module:&lt;/b&gt;&lt;br&gt;• Product: 4 tables&lt;br&gt;• Inventory: 5 tables&lt;br&gt;• Sales: 2 tables&lt;br&gt;• Purchase: 2 tables&lt;br&gt;• Finance: 6 tables&lt;br&gt;• Accounting: 11 tables&lt;br&gt;• Contacts: 4 tables&lt;br&gt;• Ecommerce: 3 tables&lt;br&gt;• Core/Auth: 2 tables&lt;br&gt;&lt;br&gt;&lt;b&gt;Key Features:&lt;/b&gt;&lt;br&gt;• Party Pattern (Contact unifies customers/suppliers)&lt;br&gt;• Event-driven integration&lt;br&gt;• Hierarchical Chart of Accounts&lt;br&gt;• Complete audit trail&lt;br&gt;• Multi-currency support&lt;br&gt;• SAT compliance (7-15 year retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E8B44A;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;spacingLeft=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="1080" width="450" height="320" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="notes" value="&lt;b style='font-size:14px;'&gt;Important Notes&lt;/b&gt;&lt;hr&gt;&lt;br&gt;&lt;b&gt;1. Party Pattern:&lt;/b&gt;&lt;br&gt;The 'contacts' table uses is_customer and is_supplier flags to unify customer and supplier management. This eliminates duplicate data and enables mixed party scenarios.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Event-Driven Integration:&lt;/b&gt;&lt;br&gt;SalesOrder → ARInvoice and PurchaseOrder → APInvoice are automated via Laravel events, not direct foreign keys in the initial create.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. GL Integration:&lt;/b&gt;&lt;br&gt;All financial transactions (AR/AP invoices, Payments) automatically create journal entries, ensuring complete accounting audit trail.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Hierarchical Accounts:&lt;/b&gt;&lt;br&gt;The 'accounts' table has self-referencing parent_id for multi-level chart of accounts (90+ accounts, 4 levels deep).&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Database Integrity:&lt;/b&gt;&lt;br&gt;• CHECK constraints enforce valid enum values&lt;br&gt;• MySQL triggers auto-calculate journal_entry totals&lt;br&gt;• Foreign key constraints with onDelete('restrict')&lt;br&gt;• Indexes on filter/sort fields for performance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;spacingLeft=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="950" y="1080" width="550" height="320" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
