{
  "moduleName": "Ecommerce",
  "description": "Phase 4.3 - Advanced Ecommerce Features: Reviews, Wishlists, and Multi-Currency Support",
  "entities": {
    "ProductReview": {
      "name": "ProductReview",
      "tableName": "product_reviews",
      "description": "Customer product reviews and ratings",
      "fields": [
        {
          "name": "product_id",
          "type": "foreignId",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "references": "products",
          "onDelete": "cascade",
          "description": "FK to products table"
        },
        {
          "name": "user_id",
          "type": "foreignId",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "references": "users",
          "onDelete": "cascade",
          "description": "User who wrote the review"
        },
        {
          "name": "rating",
          "type": "integer",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "validation": "min:1,max:5",
          "description": "Rating from 1 to 5 stars"
        },
        {
          "name": "title",
          "type": "string",
          "length": 255,
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "description": "Review title"
        },
        {
          "name": "comment",
          "type": "text",
          "required": false,
          "fillable": true,
          "sortable": false,
          "filterable": false,
          "description": "Review comment/body"
        },
        {
          "name": "is_verified_purchase",
          "type": "boolean",
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": false,
          "description": "Whether the user purchased the product"
        },
        {
          "name": "helpful_count",
          "type": "integer",
          "required": false,
          "fillable": false,
          "sortable": true,
          "filterable": false,
          "default": 0,
          "description": "Number of users who found this helpful"
        },
        {
          "name": "status",
          "type": "string",
          "length": 50,
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": "pending",
          "enum": ["pending", "approved", "rejected"],
          "description": "Review moderation status"
        }
      ]
    },
    "Wishlist": {
      "name": "Wishlist",
      "tableName": "wishlists",
      "description": "Customer wishlists",
      "fields": [
        {
          "name": "user_id",
          "type": "foreignId",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "references": "users",
          "onDelete": "cascade",
          "description": "Owner of the wishlist"
        },
        {
          "name": "name",
          "type": "string",
          "length": 255,
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": "My Wishlist",
          "description": "Wishlist name"
        },
        {
          "name": "is_default",
          "type": "boolean",
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": false,
          "description": "Whether this is the default wishlist"
        },
        {
          "name": "is_public",
          "type": "boolean",
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": false,
          "description": "Whether the wishlist is publicly shareable"
        }
      ]
    },
    "WishlistItem": {
      "name": "WishlistItem",
      "tableName": "wishlist_items",
      "description": "Items in a wishlist",
      "fields": [
        {
          "name": "wishlist_id",
          "type": "foreignId",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "references": "wishlists",
          "onDelete": "cascade",
          "description": "FK to wishlists table"
        },
        {
          "name": "product_id",
          "type": "foreignId",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "references": "products",
          "onDelete": "cascade",
          "description": "FK to products table"
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": false,
          "default": 1,
          "validation": "min:1",
          "description": "Desired quantity"
        },
        {
          "name": "priority",
          "type": "string",
          "length": 50,
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": "medium",
          "enum": ["low", "medium", "high"],
          "description": "Item priority"
        },
        {
          "name": "notes",
          "type": "text",
          "required": false,
          "fillable": true,
          "sortable": false,
          "filterable": false,
          "description": "Personal notes about the item"
        }
      ]
    },
    "Currency": {
      "name": "Currency",
      "tableName": "currencies",
      "description": "Multi-currency support",
      "fields": [
        {
          "name": "code",
          "type": "string",
          "length": 3,
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "unique": true,
          "description": "ISO 4217 currency code (USD, MXN, EUR)"
        },
        {
          "name": "name",
          "type": "string",
          "length": 100,
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "description": "Currency name"
        },
        {
          "name": "symbol",
          "type": "string",
          "length": 10,
          "required": true,
          "fillable": true,
          "sortable": false,
          "filterable": false,
          "description": "Currency symbol ($, €, etc.)"
        },
        {
          "name": "exchange_rate",
          "type": "decimal",
          "precision": "10,6",
          "required": true,
          "fillable": true,
          "sortable": true,
          "filterable": false,
          "default": 1.000000,
          "description": "Exchange rate relative to base currency"
        },
        {
          "name": "is_base",
          "type": "boolean",
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": false,
          "description": "Whether this is the base currency"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "required": false,
          "fillable": true,
          "sortable": true,
          "filterable": true,
          "default": true,
          "description": "Whether the currency is active"
        }
      ]
    }
  },
  "relationships": [
    {
      "from": "ProductReview",
      "to": "Product",
      "type": "belongsTo",
      "foreignKey": "product_id",
      "relatedModule": "Product"
    },
    {
      "from": "ProductReview",
      "to": "User",
      "type": "belongsTo",
      "foreignKey": "user_id"
    },
    {
      "from": "Wishlist",
      "to": "User",
      "type": "belongsTo",
      "foreignKey": "user_id"
    },
    {
      "from": "Wishlist",
      "to": "WishlistItem",
      "type": "hasMany",
      "foreignKey": "wishlist_id"
    },
    {
      "from": "WishlistItem",
      "to": "Wishlist",
      "type": "belongsTo",
      "foreignKey": "wishlist_id"
    },
    {
      "from": "WishlistItem",
      "to": "Product",
      "type": "belongsTo",
      "foreignKey": "product_id",
      "relatedModule": "Product"
    }
  ],
  "permissions": [
    {
      "entity": "product-reviews",
      "actions": ["index", "show", "store", "update", "destroy"],
      "roles": {
        "god": ["index", "show", "store", "update", "destroy"],
        "admin": ["index", "show", "store", "update", "destroy"],
        "tech": ["index", "show"],
        "customer": ["index", "show", "store", "update"],
        "guest": ["index", "show"]
      }
    },
    {
      "entity": "wishlists",
      "actions": ["index", "show", "store", "update", "destroy"],
      "roles": {
        "god": ["index", "show", "store", "update", "destroy"],
        "admin": ["index", "show", "store", "update", "destroy"],
        "tech": ["index", "show"],
        "customer": ["index", "show", "store", "update", "destroy"],
        "guest": []
      }
    },
    {
      "entity": "wishlist-items",
      "actions": ["index", "show", "store", "update", "destroy"],
      "roles": {
        "god": ["index", "show", "store", "update", "destroy"],
        "admin": ["index", "show", "store", "update", "destroy"],
        "tech": ["index", "show"],
        "customer": ["index", "show", "store", "update", "destroy"],
        "guest": []
      }
    },
    {
      "entity": "currencies",
      "actions": ["index", "show", "store", "update", "destroy"],
      "roles": {
        "god": ["index", "show", "store", "update", "destroy"],
        "admin": ["index", "show", "store", "update", "destroy"],
        "tech": ["index", "show"],
        "customer": ["index", "show"],
        "guest": ["index", "show"]
      }
    }
  ],
  "additionalFeatures": {
    "productAggregates": {
      "description": "Add rating aggregates to Product model",
      "fields": [
        "average_rating",
        "total_reviews"
      ]
    },
    "recommendationEngine": {
      "description": "Service for product recommendations",
      "endpoints": [
        "/api/v1/products/{id}/related",
        "/api/v1/products/{id}/frequently-bought-together",
        "/api/v1/products/recommended",
        "/api/v1/products/trending"
      ]
    }
  }
}
